# --- Base de données -------------------------------------------------
# URL "Session pooler" Supabase (Dashboard → Connect → Session pooler, port 5432)
# Format : postgresql://postgres.<ref-projet>:<mot-de-passe-bdd>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Dev local hors-ligne : postgres://postgres:postgres@127.0.0.1:5502/sodobat
DATABASE_URL=

# --- Supabase Storage (fichiers devis) --------------------------------
# Dashboard → Settings → API
# SUPABASE_URL : https://<ref-projet>.supabase.co
# SERVICE_ROLE_KEY : la clé "service_role" (secrète, jamais côté navigateur)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---------------------------------------------------------
# 32+ caractères aléatoires : openssl rand -base64 32
SESSION_SECRET=

# --- Assistant (chat) --------------------------------------------------
# Clé API Anthropic : console.anthropic.com → API Keys (commence par sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Extraction des devis (import) -------------------------------------
# Clé API OpenAI : platform.openai.com → API Keys (commence par sk-)
# gpt-5-mini : rapport qualité/prix optimal pour l'extraction structurée
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5-mini
